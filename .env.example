# Vercel Blob — required on Vercel so contact enquiries persist.
# Dashboard: Project → Storage → Create Blob Store → connect to project.
# Token is auto-added as BLOB_READ_WRITE_TOKEN (Production + Preview).
# BLOB_READ_WRITE_TOKEN=

# Optional local/VPS path when Blob token is NOT set (npm run dev uses ./storage/enquiries.json).
# ENQUIRY_STORAGE_PATH=
